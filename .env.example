# Скопируй этот файл в .env и подставь свои адреса backend-эндпоинтов
#
# ВАЖНО: переменные VITE_* ниже — это ЕДИНСТВЕННОЕ, что должно лежать в
# твоём локальном .env. Они попадают в клиентский билд (Vite вшивает их
# в JS-бандл при `npm run build`), поэтому здесь не может быть никаких
# секретов/токенов — только публичные адреса собственных эндпоинтов.
#
# Всё, что нужно самим serverless-функциям в папке api/ (токены, ключи),
# в .env НЕ кладётся — эти переменные задаются отдельно на Vercel:
# Settings → Environment Variables (см. блок "Серверные переменные" ниже).

# AI-помощник, быстрое добавление, анализ окружения (см. api/ai-proxy.js)
VITE_AI_PROXY_URL=https://твой-домен.vercel.app/api/ai-proxy

# Отправка CSV-выгрузки контактов документом в Telegram-чат (см. api/send-csv.js)
VITE_SEND_CSV_URL=https://твой-домен.vercel.app/api/send-csv

# Оплата Pro-подписки звёздами Telegram (см. api/create-stars-invoice.js).
# Отдельный секрет заводить не нужно — используется тот же TELEGRAM_BOT_TOKEN,
# что уже настроен для VITE_AI_PROXY_URL/VITE_SEND_CSV_URL.
# ВАЖНО: ещё нужно один раз вручную привязать вебхук бота (см. комментарий
# в api/telegram-webhook.js) — без него оплата зависает и не завершается.
VITE_CREATE_STARS_INVOICE_URL=https://твой-домен.vercel.app/api/create-stars-invoice

# ============================================================================
# Серверные переменные (НЕ в .env — задаются на Vercel: Settings →
# Environment Variables). Перечислены здесь только для справки, чтобы
# ничего не забыть при деплое.
# ============================================================================

# Токен бота от @BotFather. Нужен для проверки подписи initData
# (api/_lib/telegramAuth.js) и всех вызовов Bot API — ai-proxy.js,
# send-csv.js, create-stars-invoice.js, telegram-webhook.js.
# Без него все запросы к этим эндпоинтам будут отклоняться с 401.
# TELEGRAM_BOT_TOKEN=

# Ключ Google AI Studio (aistudio.google.com, бесплатный). Нужен для
# AI-помощника/быстрого добавления/анализа окружения (api/ai-proxy.js),
# а также для распознавания скриншотов и голосовых в боте баг-репортов
# (api/_lib/gemini.js). Без ключа AI-фичи отключены, остальное приложение
# работает.
# GEMINI_API_KEY=

# Необязательно — модель Gemini, переопределяет дефолт "gemini-2.5-flash"
# в api/_lib/gemini.js.
# GEMINI_MODEL=

# Нужны только для бота-накопителя баг-репортов внутри telegram-webhook.js
# (команды /status, /endpoint и т.д.) — если эта функция не используется,
# можно не заводить.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Один id чата или несколько через запятую — кому разрешено писать боту
# баг-репортов. Тоже только для telegram-webhook.js.
# ADMIN_CHAT_IDS=

# Свой секрет (случайная строка) для api/deploy-notify.js — уведомление в
# Telegram при каждом успешном деплое. Используется как ?token= в URL
# вебхука, который настраивается в самом Vercel: Settings → Webhooks →
# Event "Deployment Succeeded". Требует ADMIN_CHAT_IDS выше (кому слать).
# DEPLOY_NOTIFY_SECRET=
